        {
          "name": "SQL injection in payment_id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhooks/payment-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payment-status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"payment_id\":\"1' OR '1'='1\",\"status\":\"completed\",\"event_id\":\"evt_sqli\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404',()=>pm.response.to.have.status(404));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const sig = CryptoJS.HmacSHA256(body, pm.variables.get('webhook_secret')).toString();",
                  "pm.request.headers.upsert({key: 'x-webhook-signature', value: sig});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bug I - e-invoice webhook unsigned",
