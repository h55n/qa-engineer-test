{
  "info": {
    "name": "EU Pay QA - extended collection",
    "description": "Happy path, negative and security checks for every bug (A-L). Run the folders top to bottom with the Collection Runner. Webhook requests sign their own body (HMAC-SHA256) in a pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "webhook_secret",
      "value": "test-webhook-secret-key"
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "evt",
      "value": ""
    },
    {
      "key": "inv_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 Setup / Auth",
      "item": [
        {
          "name": "Register (new merchant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"pm{{$timestamp}}@example.com\",\"password\":\"SecurePass123!\",\"business_name\":\"Postman Co\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201',()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('auth_token',pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Seed merchant login (Bug H)",
