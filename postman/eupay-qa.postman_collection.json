              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Valid signed webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhooks/payment-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payment-status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"payment_id\":\"{{payment_id}}\",\"status\":\"completed\",\"event_id\":\"evt_postman_1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 first time, 200 already processed on rerun',()=>pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const sig = CryptoJS.HmacSHA256(body, pm.variables.get('webhook_secret')).toString();",
                  "pm.request.headers.upsert({key: 'x-webhook-signature', value: sig});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bug E - same event_id again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhooks/payment-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payment-status"
