            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhooks/e-invoice",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "e-invoice"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": \"x\",\n  \"status\": \"accepted\"\n}"
            }
