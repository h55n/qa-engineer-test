    {
      "name": "2 Webhooks (auto-signed)",
      "item": [
        {
          "name": "Bug D - no signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhooks/payment-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payment-status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{payment_id}}\",\n  \"status\": \"completed\",\n  \"event_id\": \"evt_nosig\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bug D - fake signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-webhook-signature",
                "value": "fake-signature"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/webhooks/payment-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "webhooks",
                "payment-status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{payment_id}}\",\n  \"status\": \"completed\",\n  \"event_id\": \"evt_fake\"\n}"
