              "raw": "{\"email\":\"merchant@test.com\",\"password\":\"Test123!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('seed login works',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
